# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Set it in Vercel's environment variables, never commit it or paste it in chat.
SUPABASE_SERVICE_ROLE_KEY=
# Stripe → Developers → API keys. Optional: without it the site only shows the QR codes.
# Server only, same rules as above.
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
